# Start on loopback. Use SSH forwarding for initial acceptance; no traffic cutover.
TOKENGO_LISTEN=127.0.0.1:3160
TOKENGO_DB=/var/lib/tokengo/tokengo.db
TOKENGO_MASTER_KEY_FILE=/var/lib/tokengo/master.key
TOKENGO_WEB_DIR=/opt/tokengo/current/web
TOKENGO_LOG_DIR=/var/log/tokengo
# Do not set TOKENGO_MASTER_KEY here: use the backed-up master.key file.
# Optional: dedicated OpenAI authorization and subscription inference clients only.
# Other provider connections keep their existing transport settings.
# TOKENGO_OPENAI_PROXY=http://127.0.0.1:7890
