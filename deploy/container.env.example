# Copy beside compose.yaml as .env (repository root or extracted release directory).
# No secrets belong in this file/image.
TOKENGO_IMAGE=tokengo:local
# Set to the reviewed git commit before building.
TOKENGO_REVISION=unknown
# Keep loopback for initial setup; expose through your HTTPS reverse proxy.
TOKENGO_BIND=127.0.0.1
TOKENGO_PORT=3160
