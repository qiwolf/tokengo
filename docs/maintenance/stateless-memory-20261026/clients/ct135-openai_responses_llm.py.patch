+def _apply_tokengo_history_mode(params: dict[str, Any], base_url: str | None) -> None:
+    """These providers replay text/tool messages and never resume opaque reasoning."""
+    try:
+        parsed = urlparse(base_url or "")
+        local_gateway = (
+            parsed.scheme in ("http", "https")
+            and parsed.hostname == "192.168.240.237"
+            and parsed.port in (None, 80 if parsed.scheme == "http" else 443)
+            and parsed.path.rstrip("/") == "/v1"
+            and not (parsed.username or parsed.password or parsed.query or parsed.fragment)
+        )
+    except ValueError:
+        local_gateway = False
+    if local_gateway:
+        params["extra_headers"] = {
+            **(params.get("extra_headers") or {}),
+            "X-TokenGo-History-Mode": "stateless",
+        }
 
 
